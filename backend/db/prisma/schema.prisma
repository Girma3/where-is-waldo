generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int                @id @default(autoincrement())
  email              String             @unique
  name               String
  comment            String?
  createdAt          DateTime           @default(now())
  games              Game[]
  sessions           Session[]
  leaderboardEntries LeaderboardEntry[]
}

model Game {
  id         Int         @id @default(autoincrement())
  level      Int
  image      String
  createdAt  DateTime    @default(now())
  finishedAt DateTime?
  status     String      @default("IN_PROGRESS")
  userId     Int
  characters Character[]
  user       User        @relation(fields: [userId], references: [id])

  leaderboardEntries LeaderboardEntry[]
}

model Character {
  id       Int     @id @default(autoincrement())
  name     String
  correctX Int
  correctY Int
  gameId   Int
  found    Boolean @default(false)
  game     Game    @relation(fields: [gameId], references: [id])
}

model LeaderboardEntry {
  id         Int      @id @default(autoincrement())
  level      Int
  timeTaken  Int
  achievedAt DateTime @default(now())

  // optional relation
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  // snapshot of name at the time of achievement
  userName String
  gameId   Int
  game     Game   @relation(fields: [gameId], references: [id])
}

model Session {
  userId    Int?
  createdAt DateTime @default(now())
  expiresAt DateTime
  data      String
  sid       String   @unique
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
}
